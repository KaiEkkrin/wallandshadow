{
  "name": "was-web",
  "version": "2.0.10",
  "private": true,
  "workspaces": [
    "packages/shared",
    "server"
  ],
  "type": "module",
  "dependencies": {
    "@fontsource/princess-sofia": "^5.2.7",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@popperjs/core": "^2.11.8",
    "blueimp-md5": "^2.19.0",
    "bootstrap": "^5.3.0",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.8.36",
    "fluent-iterable": "^0.1.6",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-use-measure": "^2.1.1",
    "rxjs": "^7.8.0",
    "three": "^0.186.0",
    "uuid": "^14.0.0"
  },
  "scripts": {
    "start": "vite --host",
    "dev:vite": "vite --host",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest --config ./unit/vitest.config.ts run",
    "test:unit": "vitest --config ./unit/vitest.config.ts",
    "test:server": "npm -w @wallandshadow/server run test",
    "test:shared": "npm -w @wallandshadow/shared run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui-host=0.0.0.0 --ui-port=8444",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report --host 0.0.0.0 e2e/test-results/html",
    "test:smoke": "playwright test --config ./smoke/smoke.config.ts",
    "lint": "eslint src packages/shared/src"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wallandshadow/shared": "*",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.12.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "pg": "^8.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "bcrypt": true
  }
}
