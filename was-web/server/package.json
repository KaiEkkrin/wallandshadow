{
  "name": "@wallandshadow/server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup",
    "start:prod": "node dist/index.js",
    "test": "vitest --config vitest.config.ts run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:test": "DATABASE_URL=postgresql://was:wasdev@localhost:5432/wallandshadow_test drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@hono/node-server": "^2.1.5",
    "@wallandshadow/shared": "*",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.8.36",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.13",
    "pg": "^8.13.0",
    "sharp": "^0.35.4",
    "unstorage": "^1.17.6",
    "uuid": "^14.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
