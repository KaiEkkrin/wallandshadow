# Ignore cache, config, and credential directories
# These are created via symlinks in post-create.sh and contain:
# - Claude Code CLI credentials and settings
# - VS Code config, Neovim plugins and state, Playwright browser cache

.cache/
.claude/
.claude.json
.config/
.local/
.pgdata/
.rustfs-data/
rustfs.log
# Left behind by the MinIO-based dev container (replaced by RustFS); safe to delete
.minio-data/
